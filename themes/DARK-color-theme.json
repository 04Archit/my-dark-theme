        "variable.language.fenced.markdown",
        "punctuation.section.class.end"
      ],
      "settings": {
        "foreground": "#D0D0D0"
      }
    },
    {
      "name": "Markdown - Fenced Language",
      "scope": ["variable.language.fenced.markdown"],
      "settings": {
        "foreground": "#707070"
      }
    },
    {
      "name": "Markdown - Separator",
      "scope": ["meta.separator"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#707070"
      }
    },
    {
      "name": "Markup - Table",
      "scope": ["markup.table"],
      "settings": {
        "foreground": "#D0D0D0"
      }
    },
    {
      "name": "CSS At Rules",
      "scope": ["keyword.control.at-rule", "keyword.control.at-rule.css"],
      "settings": {
        "foreground": "#B8A8C8"
      }
    },
    {
      "name": "CSS Pseudo Classes",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "#B8A8C8"
      }
    },
    {
      "name": "C++ Preprocessor",
      "scope": ["meta.preprocessor", "keyword.control.directive"],
      "settings": {
        "foreground": "#AAA0B8"
      }
    },

    {
      "name": "Final Regex Override",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.other.character-class.set.regexp"
      ],
      "settings": {
        "foreground": "#A9A1B2"
      }
    },

    {
      "name": "Spread and Rest Operators",
      "scope": ["keyword.operator.spread", "keyword.operator.rest"],
      "settings": {
        "foreground": "#8FB5D3"
      }
    },
  ],

  "semanticTokenColors": {
    "variable": "#B8CDE0",
    "parameter": "#C4C4C4",
    "property": "#B8B8B8",

    "function": "#AFC6DA",
    "method": "#AFC6DA",

    "type": "#AFC9D8",
    "class": "#AFC9D8",
    "interface": "#AFC9D8",

    "keyword": "#B8A8C8",
    "number": "#C5B29A",

    "string": "#AFC3A8",

    "comment": "#707070",
    "selfParameter": "#B8B8B8",
    "namespace": "#A7B8C8"
  }
}
