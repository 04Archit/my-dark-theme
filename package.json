{
  "name": "minimal-color-dark",
  "displayName": "Minimal Color Dark",
  "description": "A minimal near-black VS Code theme featuring two syntax highlighting variants: soft, muted colors and classic VS Code Dark+ syntax.",
  "version": "1.0.10",
  "publisher": "Dark-Voyage",
  "icon": "images/iconcat.png",
  "galleryBanner": {
    "color": "#0A0A0A",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/04Archit/my-dark-theme.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Minimal Color Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/DARK-color-theme.json"
      },
      {
        "label": "Minimal Color Dark (Classic Syntax)",
        "uiTheme": "vs-dark",
        "path": "./themes/DARK-classic-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
