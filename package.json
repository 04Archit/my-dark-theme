{
  "name": "minimal-color-dark",
  "displayName": "Minimal Color Dark",
  "description": "A minimal near-black VS Code theme featuring three syntax highlighting variants: custom muted colors, classic Dark+, and a softened VS Code 2026 Dark palette.",
  "version": "1.0.13",
  "publisher": "Dark-Voyage",
  "icon": "images/iconcat.png",
  "galleryBanner": {
    "color": "#0A0A0A",
    "theme": "dark"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/04Archit/my-dark-theme.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Minimal Color Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/DARK-color-theme.json"
      },
      {
        "label": "Minimal Color Dark (Classic Syntax)",
        "uiTheme": "vs-dark",
        "path": "./themes/DARK-classic-color-theme.json"
      },
      {
        "label": "Minimal Color Dark (2026 Syntax)",
        "uiTheme": "vs-dark",
        "path": "./themes/DARK-2026-color-theme.json"
      },
      {
        "label": "Minimal Color Dark (Graphite)",
        "uiTheme": "vs-dark",
        "path": "./themes/DARK-graphite-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
